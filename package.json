{
  "name": "droptron-launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contracts:build": "cd contracts && scarb build",
    "contracts:test": "cd contracts && snforge test",
    "verify:web": "npm run typecheck && npm run build",
    "verify": "npm run verify:web && npm run contracts:build && npm run contracts:test",
    "prepare": "node .husky/install.mjs",
    "deploy:drop:estimate": "node --env-file=.env.local scripts/deploy-drop.mjs estimate",
    "deploy:drop": "node --env-file=.env.local scripts/deploy-drop.mjs deploy",
    "declare:launch:estimate": "node --env-file=.env.local scripts/declare-launch.mjs estimate",
    "declare:launch": "node --env-file=.env.local scripts/declare-launch.mjs declare",
    "mainnet:contracts:estimate": "node --env-file=.env.local scripts/mainnet-contracts.mjs estimate",
    "mainnet:contracts:declare": "node --env-file=.env.local scripts/mainnet-contracts.mjs declare",
    "mainnet:helper:estimate": "node --env-file=.env.local scripts/mainnet-contracts.mjs estimate-helper participation",
    "mainnet:helper:deploy": "node --env-file=.env.local scripts/mainnet-contracts.mjs deploy-helper participation",
    "mainnet:factory:estimate": "node --env-file=.env.local scripts/mainnet-contracts.mjs estimate-deploy distribution-factory",
    "mainnet:factory:deploy": "node --env-file=.env.local scripts/mainnet-contracts.mjs deploy distribution-factory",
    "mainnet:claims:estimate": "node --env-file=.env.local scripts/mainnet-contracts.mjs estimate-deploy claim-redemption",
    "mainnet:claims:deploy": "node --env-file=.env.local scripts/mainnet-contracts.mjs deploy claim-redemption"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@starknet-io/get-starknet-discovery": "6.0.3",
    "@starknet-io/get-starknet-wallet-standard": "6.0.3",
    "@supabase/supabase-js": "^2.114.0",
    "next": "^16.3.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "starknet": "10.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
