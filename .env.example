# Chain-specific public Starknet RPC endpoints. Override them in .env.local when needed.
NEXT_PUBLIC_STARKNET_MAINNET_RPC_URL=https://rpc.starknet.lava.build
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=

# Backward-compatible Sepolia fallback. Prefer the chain-specific variable above.
NEXT_PUBLIC_STARKNET_RPC_URL=

# Verified STRK20 pool addresses. These are public contract addresses.
NEXT_PUBLIC_STRK20_MAINNET_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
NEXT_PUBLIC_STRK20_SEPOLIA_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Public Sepolia integration addresses. These are safe to expose to the browser.
NEXT_PUBLIC_SEPOLIA_USDC_TOKEN_ADDRESS=0x0512feAc6339Ff7889822cb5aA2a86C848e9D392bB0E3E237C008674feeD8343
NEXT_PUBLIC_SEPOLIA_DROP_TOKEN_ADDRESS=0x7f467d54281b8e47ee5ff24b69507c55cfe515a622f231d0d40b544c85fa02f
NEXT_PUBLIC_SEPOLIA_ANONYMIZER_ADDRESS=
NEXT_PUBLIC_SEPOLIA_LAUNCH_CLASS_HASH=0x1ebcdf884ef7b8d35fc5f9f0c24a18b4fab4e0bc4fefdd3c03b5e645b4eeaa9
NEXT_PUBLIC_SEPOLIA_LAUNCH_PARTICIPATION_ADDRESS=

# Mainnet deployment controls. The browser can estimate while submissions remain locked.
NEXT_PUBLIC_MAINNET_ADMIN_ADDRESS=
# locked | declare | deploy. Unlock exactly one reviewed token-creation step at a time.
NEXT_PUBLIC_MAINNET_TOKEN_CREATION_STAGE=locked
NEXT_PUBLIC_MAINNET_DROP_TOKEN_ADDRESS=
NEXT_PUBLIC_MAINNET_LAUNCH_CLASS_HASH=
NEXT_PUBLIC_MAINNET_LAUNCH_PARTICIPATION_ADDRESS=
NEXT_PUBLIC_MAINNET_CLAIM_SERIES_CLASS_HASH=
NEXT_PUBLIC_MAINNET_DISTRIBUTION_FACTORY_CLASS_HASH=
NEXT_PUBLIC_MAINNET_DISTRIBUTION_FACTORY_ADDRESS=
NEXT_PUBLIC_MAINNET_CLAIM_REDEMPTION_CLASS_HASH=
NEXT_PUBLIC_MAINNET_CLAIM_REDEMPTION_ADDRESS=
# Server/CLI-only Mainnet signer. Remove after deployment; never add NEXT_PUBLIC_ to the key.
STARKNET_MAINNET_DEPLOYER_ADDRESS=
STARKNET_MAINNET_DEPLOYER_PRIVATE_KEY=

# Temporary CLI signer for Sepolia deployment only. Never add NEXT_PUBLIC_ to these.
# Remove both values after the remaining Sepolia contracts are deployed.
STARKNET_SEPOLIA_DEPLOYER_ADDRESS=
STARKNET_SEPOLIA_DEPLOYER_PRIVATE_KEY=

# Supabase product-data persistence. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_ or expose it to client code.
SUPABASE_SECRET_KEY=
# Server-only 32-byte hex key used to encrypt private recipient manifests at rest.
DROPTON_DATA_ENCRYPTION_KEY=
